{
  "host": "0.0.0.0",
  "port": 8710,
  "project": "CodeBuild",
  "platforms": [
    "Windows",
    "Linux"
  ],
  "admin_token": "",
  "manifest_exclude_patterns": [
    "**/*.pdb",
    "**/*.download",
    "**/__pycache__/**"
  ],
  "manifest_hash": "md5",
  "max_upload_mb": 2048,
  "enabled_versions": {},
  "https": {
    "enabled": true,
    "certFile": "",
    "keyFile": "",
    "autoGenSelfSigned": true,
    "country": "CN",
    "commonName": "CloudUpdate"
  },
  "storage": {
    "backend": "s3",
    "s3": {
      "provider": "oss",
      "endpoint": "s3.oss-cn-hangzhou.aliyuncs.com",
      "region": "cn-hangzhou",
      "service": "s3",
      "bucket": "your-bucket",
      "accessKeyId": "YOUR_ACCESS_KEY_ID",
      "secretAccessKey": "YOUR_ACCESS_KEY_SECRET",
      "prefix": "cloudupdate",
      "publicBaseUrl": "",
      "addressingStyle": "virtual",
      "presignExpires": 3600
    }
  },
  "default_platform": "Windows",
  "platform_settings": {
    "Windows": {
      "hotpatcherOrder": ""
    },
    "Linux": {
      "hotpatcherOrder": ""
    }
  },
  "workspace_dir": "workspace"
}
