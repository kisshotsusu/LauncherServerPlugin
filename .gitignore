# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

# Visual Studio
.vs/

# Server runtime data
Server/data/manifests/
Server/data/versions/
# Generated self-signed TLS cert/key (private key, never commit)
Server/data/ssl/

# Unreal Engine plugin build output
Plugins/CloudUpdate/Intermediate/
Plugins/CloudUpdate/Binaries/

# Build and debug artifacts
obj/
*.pdb

# Runtime caches / temp files (should never be committed)
# WebView2 浏览器缓存真实路径为 Luncher/WebView2Data/（旧规则误写为 Luncher/app/ 下，已修正）
Luncher/WebView2Data/
Luncher/app/WebView2Data/
*.download

# Launcher 编译结果 / 构建产物（绝不入库）
Luncher/Release/
# 资源编译器临时文件（如 RCa30372）
Luncher/RCa*
# 每用户 VS 设置（Launcher.vcxproj.user）
Luncher/*.user

# cc 项目空间（运行时项目数据，不入库）
Server/projects/cc/

# Python bytecode / caches (build artifacts, never commit)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# PyInstaller build output (packaged exe goes to Server/dist, not committed)
Server/build/
Server/dist/
# Build-only virtual environment created by build_exe.bat (not committed)
Server/build_venv/
# Temporary build/verify output dirs
Server/dist_new/
Server/build_new/
# Server stdout log written when launched from the .bat helpers
Server/_*.log
Server/_*.html
